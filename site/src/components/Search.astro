---
import { withBase } from '../lib/urls.mjs';
---
<rigor-search data-base={withBase('/')}>
  <button type="button" data-open aria-label="Search documentation" aria-keyshortcuts="Control+K Meta+K">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg>
    <span>Search docs</span><kbd>⌘ / Ctrl K</kbd>
  </button>
  <dialog aria-label="Search documentation">
    <div class="search-top"><label for="rigor-query">Search documentation</label><button type="button" data-close aria-label="Close search">Esc ×</button></div>
    <input id="rigor-query" type="search" placeholder="Search skills, packs, commands…" autocomplete="off" />
    <p role="status" aria-live="polite"></p>
    <ul aria-label="Search results"></ul>
    <p class="search-foot">Search runs on this site. No account required.</p>
  </dialog>
</rigor-search>
<script>
  interface SearchResult { url: string; meta: { title?: string }; plain_excerpt?: string }
  interface Pagefind { options: (options: { baseUrl: string }) => Promise<void>; search: (query: string) => Promise<{ results: Array<{ data: () => Promise<SearchResult> }> }> }
  class RigorSearch extends HTMLElement {
    connectedCallback() {
      if (this.dataset.ready) return;
      this.dataset.ready = 'true';
      const base = this.dataset.base!;
      const open = this.querySelector<HTMLButtonElement>('[data-open]')!;
      const close = this.querySelector<HTMLButtonElement>('[data-close]')!;
      const dialog = this.querySelector('dialog')!;
      const input = this.querySelector('input')!;
      const status = this.querySelector<HTMLElement>('[role="status"]')!;
      const list = this.querySelector('ul')!;
      let service: Promise<Pagefind> | undefined;
      let sequence = 0;
      let timer: number | undefined;
      const show = () => { dialog.showModal(); input.focus(); };
      open.addEventListener('click', show);
      close.addEventListener('click', () => dialog.close());
      dialog.addEventListener('close', () => open.focus());
      dialog.addEventListener('click', event => { if (event.target === dialog) dialog.close(); });
      document.addEventListener('keydown', event => {
        if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
          event.preventDefault(); dialog.open ? dialog.close() : show();
        }
      });
      input.addEventListener('input', () => {
        const request = ++sequence;
        window.clearTimeout(timer);
        list.replaceChildren();
        const query = input.value.trim();
        if (!query) { status.textContent = ''; return; }
        status.textContent = 'Searching…';
        timer = window.setTimeout(async () => {
          try {
            service ??= (async () => {
              const url = `${base}pagefind/pagefind.js`;
              const api = await import(/* @vite-ignore */ url) as Pagefind;
              await api.options({ baseUrl: base });
              return api;
            })();
            const api = await service;
            const response = await api.search(query);
            const results = await Promise.all(response.results.map(result => result.data()));
            if (request !== sequence) return;
            const fragment = document.createDocumentFragment();
            let count = 0;
            for (const result of results) {
              const url = new URL(result.url, location.origin + base);
              if (url.origin !== location.origin || !url.pathname.startsWith(base + 'docs/')) continue;
              const item = document.createElement('li');
              const link = document.createElement('a');
              link.href = url.href;
              link.textContent = result.meta.title || 'Documentation';
              item.append(link);
              if (result.plain_excerpt) {
                const excerpt = document.createElement('p');
                // Decode Pagefind's escaped excerpt in an inert document; insert text only.
                excerpt.textContent = new DOMParser().parseFromString(result.plain_excerpt, 'text/html').body.textContent || '';
                item.append(excerpt);
              }
              fragment.append(item); count++;
            }
            list.replaceChildren(fragment);
            status.textContent = count ? `${count} matching document${count === 1 ? '' : 's'}` : `No results for “${query}”.`;
          } catch {
            service = undefined;
            if (request !== sequence) return;
            list.replaceChildren();
            status.textContent = 'Search is unavailable. You can still browse the documentation.';
          }
        }, 140);
      });
    }
  }
  if (!customElements.get('rigor-search')) customElements.define('rigor-search', RigorSearch);
</script>
<style>
  rigor-search { display: block; width: 100%; max-width: 27rem; }
  button { font: inherit; cursor: pointer; color: var(--sl-color-text); }
  [data-open] { display: flex; align-items: center; gap: .65rem; min-height: 2.6rem; width: 100%; padding: .5rem .75rem; border: 1px solid var(--sl-color-hairline); border-radius: .55rem; background: var(--sl-color-bg); text-align: left; font-size: .85rem; }
  kbd { margin-inline-start: auto; font: .65rem ui-monospace, monospace; opacity: .65; }
  dialog { width: min(calc(100% - 2rem), 42rem); max-height: 78dvh; margin: 5rem auto 1rem; padding: 1.25rem; border: 1px solid var(--sl-color-hairline); border-radius: .85rem; color: var(--sl-color-text); background: var(--sl-color-bg); box-shadow: 0 1.5rem 6rem #0004; }
  dialog::backdrop { background: #06151099; }
  .search-top { display: flex; align-items: center; justify-content: space-between; gap: .5rem; margin-bottom: .75rem; font-size: .85rem; font-weight: 600; }
  [data-close] { padding: .3rem .5rem; background: transparent; border: 0; font-size: .75rem; }
  input { box-sizing: border-box; width: 100%; min-height: 3rem; padding: .7rem; border: 1px solid var(--sl-color-gray-4); border-radius: .4rem; background: var(--sl-color-bg); color: var(--sl-color-text); font: inherit; }
  [role='status'], .search-foot { margin: .9rem 0; color: var(--sl-color-gray-2); font-size: .8rem; }
  ul { margin: 0; padding: 0; list-style: none; }
  ul :global(li) { margin: .8rem 0; padding: .8rem; border: 1px solid var(--sl-color-hairline); border-radius: .4rem; overflow-wrap: anywhere; }
  ul :global(li a) { display: block; color: var(--sl-color-text-accent); font-weight: 600; }
  ul :global(li p) { font-size: .85rem; line-height: 1.65; margin: .5rem 0 0; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .search-foot { border-top: 1px solid var(--sl-color-hairline); padding-top: .8rem; }
  @media(max-width: 32rem) { kbd { display: none; } [data-open] span { font-size: .75rem; } }
</style>
